# Original project work: djultra64.
# Build-time adaptation only: never changes pinned dependency source files.
include_guard(GLOBAL)

function(iss2000_enable_runtime_lookup_bridge runtime_target)
  if(NOT TARGET "${runtime_target}")
    message(FATAL_ERROR "Runtime lookup bridge target does not exist: ${runtime_target}")
  endif()
  get_target_property(already_enabled "${runtime_target}" ISS2000_LOOKUP_BRIDGE_ENABLED)
  if(already_enabled)
    return()
  endif()
  get_target_property(imported "${runtime_target}" IMPORTED)
  if(imported)
    message(FATAL_ERROR "Runtime lookup bridge requires a source-built target")
  endif()
  get_target_property(runtime_sources "${runtime_target}" SOURCES)
  get_target_property(runtime_directory "${runtime_target}" SOURCE_DIR)
  set(overlay_sources "")
  foreach(source IN LISTS runtime_sources)
    get_filename_component(filename "${source}" NAME)
    if(filename STREQUAL "overlays.cpp")
      get_filename_component(absolute_source "${source}" ABSOLUTE BASE_DIR "${runtime_directory}")
      list(APPEND overlay_sources "${absolute_source}")
    endif()
  endforeach()
  list(LENGTH overlay_sources overlay_count)
  if(NOT overlay_count EQUAL 1)
    message(FATAL_ERROR "Runtime lookup bridge requires exactly one overlays.cpp in ${runtime_target}")
  endif()
  list(GET overlay_sources 0 overlay_source)
  # Source properties live in the owning target's directory. A target-wide macro
  # would rename thread.cpp's external calls too and silently bypass the registry.
  set_property(SOURCE "${overlay_source}" TARGET_DIRECTORY "${runtime_target}"
    APPEND PROPERTY COMPILE_DEFINITIONS get_function=iss2000_upstream_get_function)
  set_property(TARGET "${runtime_target}" PROPERTY ISS2000_LOOKUP_BRIDGE_ENABLED TRUE)
  # A separate game configuration must not combine DIRECT with an unrenamed
  # archive, or WRAP with a renamed one. This records configuration provenance;
  # ordinary linker duplicate/undefined-symbol errors remain enabled.
  file(SHA256 "${overlay_source}" overlay_digest)
  string(REPLACE "\\" "\\\\" receipt_source "${overlay_source}")
  string(REPLACE "\"" "\\\"" receipt_source "${receipt_source}")
  file(WRITE "${CMAKE_BINARY_DIR}/iss2000-runtime-lookup-bridge.json"
    "{\n  \"schema_version\": 1,\n  \"renamed_symbol\": \"iss2000_upstream_get_function\",\n  \"definition_scope\": \"overlays.cpp\",\n  \"overlay_source\": \"${receipt_source}\",\n  \"overlay_sha256\": \"${overlay_digest}\"\n}\n")
  message(STATUS "ISS2000 lookup bridge: only ${overlay_source} renames get_function")
endfunction()

# Configure the application export and linker as one choice. The runtime
# remains a separately built dependency; no upstream source mutation is needed.
function(iss2000_configure_runtime_lookup game_target runtime_build)
  set(ISS2000_RUNTIME_LOOKUP_MODE "AUTO" CACHE STRING "Runtime lookup linkage: AUTO, DIRECT or WRAP")
  set_property(CACHE ISS2000_RUNTIME_LOOKUP_MODE PROPERTY STRINGS AUTO DIRECT WRAP)
  if(NOT ISS2000_RUNTIME_LOOKUP_MODE MATCHES "^(AUTO|DIRECT|WRAP)$")
    message(FATAL_ERROR "ISS2000_RUNTIME_LOOKUP_MODE must be AUTO, DIRECT or WRAP")
  endif()
  set(mode "${ISS2000_RUNTIME_LOOKUP_MODE}")
  if(mode STREQUAL "AUTO")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
      set(mode "WRAP")
    else()
      set(mode "DIRECT")
    endif()
  endif()
  set(receipt "${runtime_build}/iss2000-runtime-lookup-bridge.json")
  if(mode STREQUAL "DIRECT")
    if(NOT EXISTS "${receipt}")
      message(FATAL_ERROR "DIRECT lookup requires a runtime built with the source-specific lookup bridge; see docs/runtime-lookup-bridge.md")
    endif()
    file(READ "${receipt}" bridge_json)
    string(JSON version GET "${bridge_json}" schema_version)
    string(JSON renamed_symbol GET "${bridge_json}" renamed_symbol)
    string(JSON definition_scope GET "${bridge_json}" definition_scope)
    string(JSON overlay_source GET "${bridge_json}" overlay_source)
    string(JSON expected_digest GET "${bridge_json}" overlay_sha256)
    if(NOT version EQUAL 1 OR NOT renamed_symbol STREQUAL "iss2000_upstream_get_function"
        OR NOT definition_scope STREQUAL "overlays.cpp" OR NOT EXISTS "${overlay_source}")
      message(FATAL_ERROR "Invalid runtime source-specific lookup bridge receipt")
    endif()
    file(SHA256 "${overlay_source}" actual_digest)
    if(NOT actual_digest STREQUAL expected_digest)
      message(FATAL_ERROR "Runtime lookup bridge source changed; rebuild the dependency")
    endif()
    target_compile_definitions("${game_target}" PRIVATE ISS2000_LOOKUP_DIRECT)
  else()
    if(EXISTS "${receipt}")
      message(FATAL_ERROR "WRAP lookup requires an unrenamed runtime; use DIRECT for a source-specific bridge build")
    endif()
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
      message(FATAL_ERROR "WRAP lookup is validated only with a GNU-compatible ELF linker on Linux; use DIRECT")
    endif()
    target_compile_definitions("${game_target}" PRIVATE ISS2000_LOOKUP_WRAP)
    target_link_options("${game_target}" PRIVATE "-Wl,--wrap=get_function")
  endif()
  set_property(TARGET "${game_target}" PROPERTY ISS2000_RUNTIME_LOOKUP_MODE "${mode}")
  message(STATUS "ISS2000 application lookup mode: ${mode}")
endfunction()

# Optional hook for the separately configured pristine runtime. Project includes
# run before targets exist; defer once to the end of its top-level directory.
# Explicit include + function call after add_subdirectory remains supported.
if(ISS2000_RUNTIME_LOOKUP_BRIDGE_AUTO)
  cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}"
    CALL iss2000_enable_runtime_lookup_bridge librecomp)
endif()
